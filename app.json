{
  "expo": {
    "name": "Spendwise",
    "slug": "spendwise",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "spendwise",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f11b8524-2889-40de-94fd-a8edfde96887",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendwise"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#FFE4EF"
      },
      "package": "com.spendwise"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE4EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-updates",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SpendWise to use Face ID to unlock the app."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f11b8524-2889-40de-94fd-a8edfde96887"
      }
    },
    "owner": "srnanvare007"
  }
}
