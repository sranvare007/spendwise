{
  "expo": {
    "name": "spendwise",
    "slug": "spendwise",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "spendwise",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f11b8524-2889-40de-94fd-a8edfde96887",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendwise"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.spendwise"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
      "expo-sqlite",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "f11b8524-2889-40de-94fd-a8edfde96887"
      }
    },
    "owner": "srnanvare007"
  }
}
